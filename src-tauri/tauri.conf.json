{
  "productName": "FamilyHub",
  "version": "1.0.0",
  "identifier": "com.familienhub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FamilyHub",
        "width": 800,
        "height": 600,
        "minWidth": 500,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}